---
import { Collapse } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'featured', text: 'Featured' },
  { depth: 2, slug: 'ai-agent', text: 'AI & Agent' },
  { depth: 2, slug: 'learning', text: 'Learning' }
]
---

<PageLayout title='项目' data-i18n-title='projects.title' {headings} view>
  <p data-i18n='projects.intro'>
    这里汇总了我做过或正在做的项目。个人项目仓库的代码与文档还在整理中，部分项目会以博客文章或本地代码的形式先记录，待整理完成后会陆续开源。
  </p>

  <h2 id='featured' data-i18n='projects.featured'>精选项目</h2>
  <ProjectSection
    projects={[
      {
        name: 'Keshawn Blog',
        description:
          '我的个人技术博客与主页，基于 Astro 与 Astro Theme Pure 搭建，专注于大模型应用开发与 AI Agent 实践记录',
        links: [
          { type: 'github', href: 'https://github.com/Keshawn082/keshawn-blog' },
          { type: 'site', href: 'https://keshawn.cn' }
        ]
      },
      {
        name: 'ChaoJi Skill Pack（整理中）',
        description:
          '潮际汇（杭州）智能科技有限公司实习期间输出的 OpenAPI 技能包，涵盖虚拟试衣、抠图、文生图等场景',
        links: [
          { type: 'github', href: 'https://github.com/Keshawn082/keshawn-blog' }
        ]
      }
    ]}
  />

  <h2 id='ai-agent' data-i18n='projects.ai_agent'>AI 与 Agent 实践</h2>
  <ProjectSection
    projects={[
      {
        name: 'Hermes Agent 深度解析与实践（整理中）',
        description:
          '对 Hermes Agent 的源码、CLI、Skills、Profile、Workflow 等机制的系统梳理与二次开发实践',
        links: [
          { type: 'doc', href: '/blog/hermes-agent-deep-dive' }
        ]
      },
      {
        name: 'A股智能投资系统',
        description:
          '面向普通投资者的端到端智能投顾 Agent 系统。基于 LangGraph + React 构建多 Agent 协作流（基本面 / 技术面 / 估值 / 新闻解读），基于 MCP 协议封装金融数据 API，工具调用成功率 98%，可稳定输出 4k 字综合报告。模型侧基于 Qwen3-8B LoRA 微调新闻情感与风险模型（10 万级语料 + SimHash 去重，测试集准确率 91%），并设计格式 + 语义双重奖励机制的 GRPO 强化训练流程；端到端时延通过并行与缓存从 2 分钟+ 降至约 90 秒。',
        links: []
      },
      {
        name: '基于 Skills-Agent 双层架构的医疗助手',
        description:
          '面向医疗咨询的智能问答系统（2026.04 - 2026.06，项目负责人）。设计 Agent Loop + Agent Swarm 双层协作机制与 7 个原子化 Skills，统一由 SkillRegistry 编排与动态加载；融合短期会话记忆与 Mem0 长期记忆，基于 Milvus 构建医学知识库；引入约束验证 + 自动修复的 Harness Engineering 链路降低幻觉风险。智能路由准确率从 88% 提升至 95%，知识库检索准确率 87%，系统回答质量 4.5 vs doubao-seed-2.0-pro 3.9。',
        links: []
      }
    ]}
  />

  <h2 id='learning' data-i18n='projects.learning'>学习实践</h2>
  <ProjectSection
    projects={[
      {
        name: '大模型应用开发学习笔记（整理中）',
        description:
          '围绕 Prompt Engineering、Function Calling、Harness Engineering、Agent 工作流等主题的学习笔记与代码片段',
        links: [
          { type: 'doc', href: '/blog' }
        ]
      },
      {
        name: 'Agent 工程化实践记录（整理中）',
        description:
          '在实习与个人项目中沉淀的 Agent 工程化经验：可观测性、工具调用、上下文管理、Skills 设计等',
        links: [
          { type: 'doc', href: '/blog' }
        ]
      }
    ]}
  />

  <Collapse title='项目待添加 / 完善说明'>
    <p>
      目前博客中的项目卡片以「精选项目 + AI 与 Agent 实践 + 学习实践」三个分组占位为主。
      其中「精选项目」下的 ChaoJi Skill Pack、「AI 与 Agent 实践」下新加入的 A 股智能投资系统与医疗助手
      的独立仓库与文档尚未公开，需要后续整理完成后单独建仓并补充：
    </p>
    <ul>
      <li>独立的 GitHub 仓库地址（README、技术栈、运行说明、截图）</li>
      <li>可对外展示的演示站点或录屏</li>
      <li>核心实现思路、关键代码片段、效果对比</li>
      <li>对应的博客文章链接</li>
    </ul>
    <p>
      在整理完成前，本项目页只展示已开源或可公开的项目，不展示实习公司内部项目代码。
    </p>
  </Collapse>

</PageLayout>