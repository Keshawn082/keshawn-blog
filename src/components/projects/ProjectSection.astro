---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import type { IconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'

interface Project {
  image?: string
  name: string
  description: string
  links: {
    type: string
    href: string
  }[]
}

interface Props {
  class?: string
  projects: Project[]
}
const { class: className, projects, ...props } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{jpeg,jpg,png,gif,avif.webp,webp}'
)
const projectIconSet: Record<string, IconsType> = {
  github: 'github-circle',
  site: 'earth',
  doc: 'document',
  release: 'package'
}

// Split description on blank lines into paragraphs so we can control
// inter-paragraph spacing with CSS instead of relying on raw newlines
// (which also produced the leading-space / mis-alignment look).
const splitParagraphs = (text: string): string[] =>
  text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean)
---

<div class={className} {...props}>
  <div class='grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2 sm:gap-y-4'>
    {
      projects.map((project) => {
        var imagePath = null
        if (project.image) {
          imagePath = '/src/assets/projects/' + project.image
          if (!images[imagePath])
            throw new Error(
              `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif,avif,webp}"`
            )
        }

        const paragraphs = splitParagraphs(project.description)

        return (
          <div class='relative overflow-hidden rounded-xl border'>
            {imagePath && (
              <Image
                class='absolute end-0 z-0 m-0 h-full w-1/2 object-cover opacity-40'
                src={images[imagePath]()}
                alt={project.name}
                loading='lazy'
                style={{
                  msMaskImage:
                    '-ms-linear-gradient(left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)',
                  WebkitMaskImage:
                    '-webkit-linear-gradient(left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)',
                  maskImage: 'linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)'
                }}
              />
            )}
            <div
              class={cn(
                'relative z-10 flex flex-col gap-y-1 px-2 py-1.5 sm:px-3 sm:py-2',
                imagePath && 'me-20'
              )}
            >
              {project.links.length > 0 ? (
                <a
                  class='line-clamp-1 font-medium text-foreground no-underline transition-colors'
                  href={project.links[0].href}
                  target='_blank'
                >
                  {project.name}
                </a>
              ) : (
                <span class='line-clamp-1 font-medium text-foreground'>
                  {project.name}
                </span>
              )}
              <div class='project-description leading-snug text-muted-foreground'>
                {paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
              {project.links.length > 0 && (
                <div class='flex flex-row items-center gap-x-2 sm:gap-x-3'>
                  {project.links.map((link) => {
                    const icon = projectIconSet[link.type]
                    return (
                      <a
                        href={link.href}
                        class='rounded-full bg-muted p-1 text-muted-foreground transition-colors sm:p-1.5'
                        aria-label={link.type}
                        target='_blank'
                      >
                        <Icon class='size-5' name={icon} />
                      </a>
                    )
                  })}
                </div>
              )}
            </div>
          </div>
        )
      })
    }
  </div>
</div>

<style>
  /* Project card description: fixed-height block with vertical scroll
     so long descriptions can be read in full without expanding the card. */
  .project-description {
    max-height: 12rem; /* ~ 192px, fits ~10 lines of compact text */
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 0.25rem;
    font-size: 0.8rem;
    line-height: 1.45;
    text-align: start;
        word-break: break-word;
  }
  /* Reset <p> defaults so first paragraph aligns flush with title */
  .project-description p {
    margin: 0;
  }
  /* Half-line gap between paragraphs (≈ 0.5 of line-height) */
  .project-description p + p {
    margin-top: 0.5em;
  }
  /* Slim scrollbar styling */
  .project-description::-webkit-scrollbar {
    width: 6px;
  }
  .project-description::-webkit-scrollbar-track {
    background: transparent;
  }
  .project-description::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 9999px;
  }
  .project-description::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, currentColor 45%, transparent);
  }
  .project-description {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, currentColor 25%, transparent) transparent;
  }
</style>